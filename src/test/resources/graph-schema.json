{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version", "generated_for", "target", "method_bodies", "chains",
    "local_context", "stats", "degradations"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2" },
    "generated_for": {
      "type": "object",
      "required": ["project", "commit_hash_proxy", "timestamp"],
      "properties": {
        "project": { "type": "string" },
        "commit_hash_proxy": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "required": ["fqn", "signature", "file", "line_start", "line_end", "current_body"],
      "properties": {
        "fqn": { "type": "string" },
        "signature": { "type": "string" },
        "file": { "type": "string" },
        "line_start": { "type": "integer" },
        "line_end": { "type": "integer" },
        "current_body": { "type": "string" }
      }
    },
    "method_bodies": {
      "type": "object",
      "description": "Sliced bodies of intermediate methods, keyed by FQN. Tests and target are NOT here — see chain.test and target.current_body.",
      "additionalProperties": {
        "type": "object",
        "required": ["fqn", "signature", "file", "line_start", "line_end", "sliced_body"],
        "properties": {
          "fqn": { "type": "string" },
          "signature": { "type": "string" },
          "file": { "type": ["string", "null"] },
          "line_start": { "type": "integer" },
          "line_end": { "type": "integer" },
          "sliced_body": { "type": "string" },
          "sliced_body_truncated": { "type": "boolean" },
          "warnings": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "chains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "depth", "virtual_steps", "test", "steps"],
        "properties": {
          "id": { "type": "string", "pattern": "^chain_\\d+$" },
          "depth": { "type": "integer" },
          "virtual_steps": { "type": "integer" },
          "test": {
            "type": "object",
            "required": ["fqn", "file", "line", "sliced_body"],
            "properties": {
              "fqn": { "type": "string" },
              "file": { "type": "string" },
              "line": { "type": "integer" },
              "sliced_body": { "type": "string" }
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["caller_ref", "callee_ref", "call_site", "args", "virtual"],
              "properties": {
                "caller_ref": {
                  "type": "string",
                  "description": "Either 'test' (body in chain.test.sliced_body), 'target' (body in target.current_body), or an FQN key in method_bodies."
                },
                "callee_ref": {
                  "type": "string",
                  "description": "Same resolution as caller_ref."
                },
                "call_site": {
                  "type": "object",
                  "required": ["file", "line", "column", "code"],
                  "properties": {
                    "file": { "type": ["string", "null"] },
                    "line": { "type": "integer" },
                    "column": { "type": "integer" },
                    "code": { "type": "string" }
                  }
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["index", "origin"],
                    "properties": {
                      "index": { "type": "integer" },
                      "origin": { "type": "string" }
                    }
                  }
                },
                "virtual": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "local_context": {
      "type": "object",
      "required": ["siblings", "used_types"],
      "properties": {
        "siblings": { "type": "array" },
        "used_types": { "type": "array" }
      }
    },
    "stats": {
      "type": "object",
      "required": ["total_chains", "distinct_tests", "distinct_method_bodies", "truncated"],
      "properties": {
        "total_chains": { "type": "integer" },
        "distinct_tests": { "type": "integer" },
        "distinct_method_bodies": { "type": "integer" },
        "truncated": { "type": "boolean" }
      }
    },
    "degradations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string" }
        }
      }
    }
  }
}
