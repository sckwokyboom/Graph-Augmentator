# Keep POSIX entry points LF even when cloned by Git-for-Windows with
# core.autocrlf=true — a CRLF shebang makes the kernel look for `/bin/sh\r`
# and the launcher dies with a confusing "No such file or directory".
gradlew      text eol=lf
*.sh         text eol=lf
*.py         text eol=lf
# Windows batch wrappers must stay CRLF.
gradlew.bat  text eol=crlf
*.bat        text eol=crlf
# Never touch binaries.
*.jar        binary
*.zip        binary
*.class      binary
